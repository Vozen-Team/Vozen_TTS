# Bot token (Discord Developer Portal -> Bot)
DISCORD_TOKEN=
# Application/Client ID (Discord Developer Portal -> General Information)
CLIENT_ID=
# Path to the Piper binary (e.g. C:\piper\piper.exe)
PIPER_PATH=piper
# Folder with Piper's .onnx models (e.g. C:\piper\models)
MODELS_DIR=./models
# Path to the SQLite database
DB_PATH=./tts.db
# Deploy-time online backups. Defaults outside the Git checkout so `git reset`
# cannot touch them. Keep the database, backup folder, and .env in an encrypted
# off-VPS backup too; a local copy does not survive total VPS/disk loss.
DB_BACKUP_DIR=../vozen-backups
DB_BACKUP_RETENTION_DAYS=30
# Default voice (model name without extension)
DEFAULT_VOICE=en_US-amy-medium
# Default speed (1.0 = normal; higher values = slower in Piper)
DEFAULT_SPEED=1.0
# Maximum playback queue capacity
QUEUE_CAP=20
# Rust migration cutover guard. `shadow` keeps the existing per-surface canaries. `full` is
# deliberately fail-closed and is accepted only after every flag below is explicitly true.
RUST_RUNTIME_MODE=shadow
# Additional operator acknowledgement required before any partial canary makes Node yield.
# Leave false until the Rust process is online and its live checks pass; set it true only after
# starting Rust. Full mode also requires every promoted surface below and the same acknowledgement.
RUST_RUNTIME_READY=false
# Rust migration: explicit acknowledgement that the authenticated browser API (account,
# activation and receipt claims) is owned by Rust. Full mode also requires PREMIUM_API_ENABLED=true.
RUST_BROWSER_API_ENABLED=false
# Rust migration: keep OFF until the Rust process is running with `voice-driver` and has passed
# live shadow checks. Only literal `true` yields /join, /leave, /tts, /laugh, /joke, /8-ball,
# /fortune, /fact, /wyr, /rizz, /sound, /skip and /shut-up
# to Rust; every other command stays in Node. Start Rust before turning this on in the Node
# environment.
RUST_CORE_VOICE_ENABLED=false
# Rust migration: `/queue` controls. Requires the Rust voice-driver, the core canary above and a
# provider-compatible TTS_ENGINE; Node retains queue ownership until this flag is explicitly enabled.
RUST_QUEUE_ENABLED=false
# Rust migration: direct `/pronunciation` and `/server-pronunciation` list/remove/add leaves.
# Add-without-options stays in Node so its modal workflow remains intact.
RUST_PRONUNCIATION_ENABLED=false
# Rust migration: `/config language` only. Requires Manage Server and leaves all other config
# subcommands in Node until their own parity slices are ready.
RUST_CONFIG_LANGUAGE_ENABLED=false
# Rust migration: boolean `/config` leaves (auto-read, enabled, roles-independent toggles and
# greeting/soundboard controls). Other config leaves remain Node-owned.
RUST_CONFIG_TOGGLES_ENABLED=false
# Rust migration: `/config max-chars` and `/config rate-limit`, with the existing 1-2000 and
# 1-120 validation ranges. Other numeric/admin settings remain Node-owned.
RUST_CONFIG_NUMERIC_ENABLED=false
# Rust migration: `/config role` (auto-read role restriction and clear operation).
RUST_CONFIG_ROLE_ENABLED=false
# Rust migration: `/config default-voice`, validated against the discovered Piper model catalogue.
RUST_CONFIG_DEFAULT_VOICE_ENABLED=false
# Rust migration: `/config tts-channel`, with cached GuildText and bot View Channel checks.
RUST_CONFIG_CHANNEL_ENABLED=false
# Rust migration: mutually-exclusive `/config priority-role` and `/config blocked-role` leaves.
RUST_CONFIG_QUEUE_ROLES_ENABLED=false
# Rust migration: `/config greet-language`, preserving the 19 greeting locales.
RUST_CONFIG_GREET_LANGUAGE_ENABLED=false
# Rust migration: `/config block-word add/remove` with the existing 500-word guild cap.
RUST_CONFIG_BLOCKWORD_ENABLED=false
RUST_CONFIG_SHOW_ENABLED=false
RUST_CONFIG_RESET_ENABLED=false
RUST_UPTIME_ENABLED=false
RUST_INVITE_ENABLED=false
RUST_HELP_ENABLED=false
RUST_VOTE_ENABLED=false
RUST_TOP_SPEAKERS_ENABLED=false
RUST_BIRTHDAY_ENABLED=false
RUST_BOT_STATS_ENABLED=false
RUST_SERVER_STATS_ENABLED=false
# Rust `/stats` (Manage Guild) canary. Requires Rust-owned process metrics; disabled by default.
RUST_STATS_ENABLED=false
RUST_PREMIUM_ENABLED=false
RUST_REDEEM_ENABLED=false
RUST_PRIVACY_ENABLED=false
# Rust migration: read-only `/game list`.
RUST_GAME_LIST_ENABLED=false
# Rust migration: read-only `/game leaderboard` and `/game stats`.
RUST_GAME_SCORES_ENABLED=false
# Rust migration: live `/game play` and `/game stop` gateway adapter. Keep false until the Rust
# runtime has passed its live game checks.
RUST_GAME_PLAY_ENABLED=false
# Rust migration: bundled read-only/control-plane commands (help, invite, vote, uptime,
# statistics, top-speakers and game list/leaderboard/stats). This only takes effect when the
# Rust runtime is already running; voice, live games, STT, payments and destructive commands keep
# their independent canaries. Keep OFF until the Rust process has passed its live checks.
RUST_PUBLIC_COMMANDS_ENABLED=false
# Rust migration: private `/tts-file` export. Requires a running Rust gateway, a Piper model
# catalogue and TTS_ENGINE=piper. Keep off until its private-file shadow checks pass.
RUST_TTS_FILE_ENABLED=false
# Rust migration: message context-menu transcription. Keep OFF until the Whisper sidecar and
# ffmpeg paths are installed and the private ephemeral response has passed live checks.
RUST_TRANSCRIBE_MESSAGE_ENABLED=false
# Enables Songbird Opus receive/decode for the Rust live `/transcribe` canary. Keep off until the
# consent-gated receiver has been tested in the target deployment.
RUST_TRANSCRIBE_LIVE_ENABLED=false
# Rust migration: message context-menu `/Speak`. Requires the Rust voice core and Piper runtime.
RUST_SPEAK_CONTEXT_ENABLED=false
# Optional STT runtime paths (defaults: python3, tools/whisper_sidecar.py and ffmpeg).
WHISPER_PYTHON=python3
WHISPER_SCRIPT=tools/whisper_sidecar.py
WHISPER_MODEL=
FFMPEG_PATH=ffmpeg
STT_MAX_CONCURRENCY=1
# Rust migration: textual `/voice` settings (`set`, reset, detection, opt-in/out, nickname and
# effect). Requires the Rust gateway and MODELS_DIR; provider-specific voice selection remains
# independently validated by the Rust preference service.
RUST_VOICE_PREFERENCES_ENABLED=false
# Rust migration: private `/translate text` only. Server mappings and automatic translation
# remain Node-owned unless their separate flags are also explicitly enabled.
RUST_TRANSLATE_TEXT_ENABLED=false
# Rust migration: message context-menu `/Translate`. Requires the Rust translation text runtime.
RUST_TRANSLATE_CONTEXT_ENABLED=false
# Rust migration: `/translate` server mapping/admin leaves.
RUST_TRANSLATION_ADMIN_ENABLED=false
# Rust migration: `/translate language`, `/translate speak-language` and `/translate opt-out`.
RUST_TRANSLATION_PREFERENCES_ENABLED=false
# Rust migration: mapped-channel automatic translation. Independent of the private text command.
RUST_AUTOMATIC_TRANSLATION_ENABLED=false
# Rust migration: guild welcome message on first gateway join.
RUST_WELCOME_ENABLED=false
# Rust migration: experimental same-call auto-read only. Requires RUST_CORE_VOICE_ENABLED=true
# and a provider-compatible TTS_ENGINE.
# Node translation still runs; Node autojoin and effects are intentionally skipped for Rust-owned
# messages. Keep this OFF in production until those paths reach parity and live shadow checks pass.
RUST_MESSAGE_AUTOREAD_ENABLED=false
# Rust migration: `/randomizer` menu/modal flow. Requires the Rust core voice canary and a
# provider-compatible TTS_ENGINE; leave OFF until the live canary has been validated.
RUST_RANDOMIZER_ENABLED=false
# Rust migration: experimental `/cast` panel. Requires the Rust core voice canary and a
# provider-compatible TTS_ENGINE; leave OFF until the live canary has been validated.
RUST_CAST_ENABLED=false
# Guided `/setup` onboarding canary. Requires the Rust voice core and a provider-compatible
# runtime.
RUST_SETUP_ENABLED=false
# Optional isolated WAV cache for the Rust voice path (default: ./audio-cache/rust)
RUST_VOICE_CACHE_DIR=
# Optional isolated WAV cache for Rust's OpenAI tts-1 provider (default: ./audio-cache/rust-neural)
RUST_NEURAL_CACHE_DIR=
# Rust migration: browser dashboard route. Keep OFF until the Rust process is listening only
# behind a reviewed reverse proxy and its OAuth/dashboard shadow checks pass. Requires
# PREMIUM_API_ENABLED=true, HEALTH_PORT, CLIENT_ID, PREMIUM_API_ORIGIN and MODELS_DIR.
RUST_DASHBOARD_ENABLED=false
# Maximum number of characters per message
MAX_CHARS=300
# Per-user request limit per minute (leave room for normal conversation bursts)
RATE_PER_MIN=8
# TTS engine: 'piper' (default, local), 'neural' (official OpenAI API), or the legacy
# 'gtts'/'router' modes. The legacy modes call an unsupported Google Translate endpoint
# and are explicit operator opt-ins; do not use them for a service that requires a
# supported API contract. Invalid values fall back to Piper. Neural requires a key.
TTS_ENGINE=piper
# OpenAI API key — only needed when TTS_ENGINE=neural.
OPENAI_API_KEY=
# Minimum log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
# Bot presence/activity text (shown as "Listening to ...").
# Optional: if empty, uses the brand default "type it, hear it. • /setup".
# Setting it here overrides the default. Keep it short (Discord truncates long texts).
PRESENCE_TEXT=
# Port for the optional HTTP health endpoint (GET /health -> 200 {"status":"ok"}).
# Optional: if EMPTY/absent, NO server is started (default). Setting a
# port (e.g. 8080) enables a minimal server for uptime monitors (UptimeRobot).
# Exposes no sensitive data. See docs/GO-PUBLIC.md (24/7).
HEALTH_PORT=
# Bind address for HEALTH_PORT. Keep the default loopback for a host process; Docker deployments
# that publish the port should use 0.0.0.0 so the host reverse proxy can reach the container.
HEALTH_HOST=127.0.0.1
# Loopback guard shared by the Node supervisor and the Rust runtime. Keep the default so a
# cutover cannot run two gateway sessions with the same Discord token. Set `off` only when
# intentionally running different bot tokens on the same machine (use a distinct port instead
# when possible).
SINGLE_INSTANCE_PORT=59595
# Rust migration note: the promoted Rust runtime uses this same loopback listener for the
# account/premium, dashboard, admin, Ko-fi, Top.gg and public-status routes. Set HEALTH_PORT
# deliberately when any Rust HTTP surface is enabled; the legacy Node-only webhook ports below
# do not configure the Rust listener.
# Optional public-status RESPONSE on the same loopback-only health listener. OFF by default.
# This does not publish a URL: a reviewed reverse-proxy/DNS change is a separate manual rollout.
# When enabled, GET /status contains only coarse bot/database/provider states and an optional
# bounded incident notice. It never exposes IDs, message/audio text, quotas or raw errors.
PUBLIC_STATUS_ENABLED=false
PUBLIC_STATUS_INCIDENT=
# Sharding (opt-in, only for scaling near ~1000+ guilds). EMPTY/absent =>
# single-process (default — you don't need to touch this). 'auto' lets Discord
# choose the count; an integer >= 2 fixes the number of shards. Only takes effect
# with `npm run start:sharded`; normal `npm start` ignores this variable.
# NOTE: it is called BOT_SHARDS (not SHARDS) on purpose — SHARDS and SHARD_COUNT
# are reserved and read from the environment by the discord.js Client itself,
# which would break single-process `npm start`. Do not rename it to SHARDS.
BOT_SHARDS=
# top.gg webhook (opt-in, P11.5) — records the bot's top.gg votes.
# VOTE REWARD: each eligible vote grants 24h of Vozen Plus, up to four rewards
# in a rolling 30-day window and never more than 48h ahead.
# DEDICATED port for the webhook server (POST /webhook/topgg). EMPTY/absent =>
# NO server is started (default). Setting a port (e.g. 8081) enables it.
# It is a SEPARATE port from HEALTH_PORT on purpose (do not reuse the same one):
# don't mix a public uptime endpoint with an authenticated webhook endpoint.
TOPGG_WEBHOOK_PORT=
# Webhook secret from the Top.gg dashboard. New v1 webhooks use it to sign the
# raw body (x-topgg-signature, HMAC-SHA256); legacy v0 sends it directly in the
# Authorization header. Without it, the public shared route is disabled and the
# optional dedicated listener refuses to start by default (SEC-01).
# Do not duplicate keys: dotenv uses the last value, so a later empty line silently
# replaces a valid secret. Startup validation warns about this condition.
TOPGG_WEBHOOK_SECRET=
# Stable HMAC key for the pseudonymous 30-day vote-reward ledger. This is
# deliberately different from TOPGG_WEBHOOK_SECRET: rotating the webhook must
# not reset rate-limit or replay protection. Generate once (`openssl rand -hex
# 32`) and keep it in the untracked runtime environment.
VOTE_REDEMPTION_SECRET=
# Wave 3 — top.gg API token to PUBLISH the server count (ranking/discovery).
# Different from the WEBHOOK_SECRET above: this is the API token (top.gg ->
# Edit -> Webhooks/API). EMPTY => auto-post does NOT start (opt-in). With a
# token, it publishes the server_count at startup and every 30 min.
TOPGG_TOKEN=
# Wave 3 — URL of a Discord webhook to SEND unexpected errors to (gateway/
# rejections/exceptions) for production monitoring. EMPTY => no sending (opt-in).
# Create it in: Channel settings -> Integrations -> Webhooks -> New webhook -> Copy URL.
# There is dedup (the same error does not spam the channel).
ERROR_WEBHOOK_URL=
# Plan 036 — Discord webhook notified when a buyer cannot activate a purchase and
# sends the email they used on Ko-fi (POST /api/claim-help). The email is a LOOKUP
# HINT, not proof of ownership (plan 021): Ko-fi's transaction search matches by email,
# so you paste it, find the paid order, and grant by hand with /premium grant. Nothing
# here activates anything. Only the Discord ID and the email are sent; no pass, no product.
# EMPTY => falls back to ERROR_WEBHOOK_URL. Both empty => the endpoint answers 503 and
# the site tells the buyer to copy a message to the support server instead.
CLAIM_HELP_WEBHOOK_URL=
# Per-segment multilingual synthesis. It is ON by default; set the exact value `false`
# to disable it globally. The current fixed-voice speech path may bypass segmentation.
MULTILINGUAL_SEGMENTS=
# Kokoro neural engine (Plus/Premium-only, selected with /voice set engine:Kokoro). AUTO-DETECTED from
# tools/kokoro-venv (install it with tools/setup-kokoro.ps1) — no env needed for a
# default install. Set KOKORO_CMD only to point at a custom sidecar command. Without
# the sidecar installed, choosing Kokoro transparently uses the configured default.
# Piper remains the safe default unless the operator explicitly selects another mode.
KOKORO_CMD=
# Languages Kokoro serves (locale prefixes, CSV). Anything else uses the default engine.
# Default = en,es,fr,hi,it,pt,ja (validated). Mandarin (zh) needs misaki[zh], excluded.
KOKORO_LANGS=

# Google HD engine (OPT-IN, Premium-only: /voice set engine:"Google HD"). Official
# Google Cloud Text-to-Speech, STANDARD voices. Without this key the `gcloud` path uses
# the configured default and makes no billable Google Cloud request.
# Cost: $4 per 1M chars, with a permanent 4M chars/month free tier. Create a Google
# Cloud project, enable the Text-to-Speech API, make an API key RESTRICTED to that API,
# and set a billing/quota alert. Keep this key ONLY here on the VPS (never in the repo).
GOOGLE_TTS_API_KEY=
# Cost safeguards (allowances). Tune without a redeploy. The bot counts chars ONLY on a
# real Google call (cache miss) and falls back to the configured default once spent. Worst
# case (pool spent, free tier gone): Plus $0.40 vs €3.99; 2-server pass $1.60 vs €6.99;
# 5-server pass $4.00 vs €13.99 — always profitable by construction.
# Per-request cap: longer text goes directly to the configured default.
GCLOUD_MAX_CHARS=500
# Personal Plus pool, per person per month (~2000 messages; max cost $0.40).
GCLOUD_PLUS_MONTHLY_CHARS=100000
# Pass pool per month, SHARED across the pass's servers (keyed by the pass owner). The
# Tier is picked by seat count: the 2-server plan uses legacy PASS3 and the 5-server plan uses
# legacy PASS8. The variable names stay stable so existing production configuration keeps working.
GCLOUD_PASS3_MONTHLY_CHARS=400000
GCLOUD_PASS8_MONTHLY_CHARS=1000000
# Global daily backstop (in-memory circuit-breaker against bugs/abuse). 0 = disabled.
GCLOUD_DAILY_CHAR_BUDGET=300000

# â”€â”€ Opt-in text translation (disabled unless BOTH values are set) â”€â”€
# Translation is OFF in every server until a Manage Server admin creates a channel mapping
# and runs /translate enable. It is TEXT ONLY: it never speaks translated output.
# Supported provider currently: azure. Leave TRANSLATION_PROVIDER empty/disabled to keep the
# external path inert. Use an HTTPS Azure Translator endpoint and keep the key only on the VPS.
TRANSLATION_PROVIDER=disabled
TRANSLATION_AZURE_ENDPOINT=
TRANSLATION_AZURE_KEY=

# ─── Premium / pagamentos (temporariamente desligados) ───────────────────────
# O checkout está desativado enquanto preparamos Stripe. Deixa false até o contrato
# de checkout/webhook Stripe estar validado; passes existentes e grants do owner continuam.
RUST_PAYMENTS_ENABLED=false
RUST_NEW_PAYMENTS_ENABLED=false
# O checkout Stripe só fica ativo quando RUST_PAYMENTS_ENABLED=true,
# PREMIUM_API_ENABLED=true e todas as variáveis STRIPE_* abaixo estão preenchidas.
# O cliente entra com Discord antes do checkout; não existe recolha de envio.
#
# Página do Ko-fi mostrada no /premium info e no site. Mete a TUA página.
KOFI_URL=
# Webhook do Ko-fi: token de verificação (Ko-fi > Settings > API > Webhooks).
# VAZIO => o servidor de webhook NÃO arranca (vendas só via /vozengrant manual).
# Cuidado: não dupliques chaves neste ficheiro; o dotenv usa a ÚLTIMA — uma
# linha `KOFI_WEBHOOK_TOKEN=` vazia a seguir à boa desliga o webhook em silêncio.
KOFI_WEBHOOK_TOKEN=
# Porta local do endpoint do webhook (o teu host/reverse-proxy aponta o domínio
# para aqui, no caminho POST /). Default 3001.
# Legacy Node listener port. When the Rust runtime owns the HTTP surface, use HEALTH_PORT
# instead: Rust serves all enabled HTTP routes from one shared loopback listener.
KOFI_WEBHOOK_PORT=3001
# Itens da LOJA Ko-fi (ex.: passes ANUAIS) -> produto. Formato:
#   codigo:plano:dias[:licencas]   separados por virgulas
# O `codigo` e o direct_link_code do item (o que aparece no link ko-fi.com/s/<codigo>).
# PORQUE existe: um "Shop Order" do Ko-fi NAO traz o NOME do produto no webhook — so o
# codigo. As memberships (mensais) sao lidas pelo tier_name e nao precisam disto; os itens
# de loja precisam, senao a compra e ignorada em silencio.
# `plano` = plus | premium. `licencas` so conta no premium (default 2).
# VAZIO => sem produtos de loja (anual desligado). Entradas malformadas sao ignoradas.
# Exemplo histórico (não ativar enquanto os pagamentos estiverem desligados):
#   KOFI_SHOP_MAP=a1b2c3:plus:365, d4e5f6:premium:365:2, g7h8i9:premium:365:5
KOFI_SHOP_MAP=
# Stripe (produto digital; sem shipping_address_collection). Os IDs são criados no
# Dashboard Stripe em modo de teste/produção e nunca devem ser colocados no frontend.
STRIPE_SECRET_KEY=
# Safe to expose to Stripe.js; used by the embedded checkout on /account.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_YEARLY=
# Painel Premium do site: login com Discord e ver o estado da conta. Monta uma API de
# LEITURA (GET /api/me/premium) no MESMO servidor HTTP (mesma porta acima). OPT-IN:
# só arranca com PREMIUM_API_ENABLED=true. Precisa de HTTPS público (o mesmo
# reverse-proxy do webhook) e de o redirect URI do site estar registado na app do
# Discord (Developer Portal > OAuth2 > Redirects).
PREMIUM_API_ENABLED=false
# HTTPS origin of your site allowed by CORS, without a trailing slash.
# Fictional example; replace with your site origin before enabling.
PREMIUM_API_ORIGIN=https://bot.example.com
# Consola de administração (plano 037): rotas /api/admin/* no MESMO servidor HTTP.
# Dá/revoga passes Premium/Plus e vê os servidores. Login = OAuth do Discord: só a conta
# do OWNER_ID (acima) entra. Sem ADMIN_SESSION_SECRET/OWNER_ID/ADMIN_CLIENT_ID => inerte
# (nenhuma rota admin existe — é o que mantém o repo público seguro).
# Segredo HMAC da sessão do painel. TEM de ter >= 32 chars ou o painel fica DESLIGADO
# (fail-closed). Gera um forte: openssl rand -hex 32
# Rust migration opt-in: keeps the admin router absent until the Rust process is explicitly
# promoted in a controlled environment. The Node console remains unchanged by this flag.
RUST_ADMIN_API_ENABLED=false
ADMIN_SESSION_SECRET=
# HTTPS origin of your private panel, without a trailing slash.
# Fictional example; replace with your panel origin before enabling.
ADMIN_PANEL_ORIGIN=https://admin.example.com
# Public client ID of your dedicated admin OAuth application.
# Tokens must match this application and the configured OWNER_ID.
# Example: ADMIN_CLIENT_ID=<YOUR_ADMIN_APP_PUBLIC_ID>.
ADMIN_CLIENT_ID=
# Comando OWNER-ONLY /vozengrant (conceder Premium/Plus à mão: recuperação de
# webhook, ofertas). É registado SÓ neste servidor de controlo (invisível ao
# público) e o handler valida o dono real (resolvido do Discord). VAZIO => o
# comando não é registado.
OWNER_GUILD_ID=
# Dono do bot (fallback explícito). Normalmente desnecessário — o dono é
# resolvido automaticamente via a application/Team no arranque.
OWNER_ID=

# Optional server-side TTS installation OAuth. The static site keeps its direct
# start endpoint empty until this exact callback and both secrets are provisioned.
# Never put either secret into JavaScript or a dashboard URL.
RUST_TTS_INSTALL_OAUTH_ENABLED=false
TTS_INSTALL_OAUTH_CLIENT_SECRET=
TTS_INSTALL_OAUTH_STATE_SECRET=
TTS_INSTALL_OAUTH_REDIRECT_URI=https://api.example.com/api/install/tts/callback
TTS_INSTALL_OAUTH_SUCCESS_REDIRECT=https://bot.example.com/dashboard/

# Optional private Cloudflare Web Analytics admin proxy. The read-only API token
# remains on the runtime; the public beacon uses a separate non-secret site tag.
CLOUDFLARE_WEB_ANALYTICS_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# Web Analytics property ID from /web-analytics/edit/<siteTag>; do not use the public beacon token.
CLOUDFLARE_WEB_ANALYTICS_SITE_TAG=
CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Link de suporte/denúncia mostrado no /help (a Política de Desenvolvedor do
# Discord exige um canal de report). Default = https://discord.gg/4kYw2WUbNN.
SUPPORT_URL=

# Discord Premium Apps (monetização NATIVA do Discord, opcional — o Ko-fi
# funciona sem isto). Cria os SKUs no Developer Portal > Monetization e cola
# aqui os IDs; sem eles o sync de entitlements fica inerte ("só /redeem").
PREMIUM_GUILD_SKU_ID=
PREMIUM_USER_SKU_ID=

# ── Tuning avançado (defaults sensatos; só mexer com razão) ─────────────────
# Silêncio inicial antes da fala na leitura de canal (ms). Default 300.
MESSAGE_LEAD_MS=
# Parâmetros de síntese do Piper (naturalidade). Defaults calibrados por voz.
NOISE_SCALE=
NOISE_W=
SENTENCE_SILENCE=
# Legacy gTTS circuit breaker: consecutive-failure threshold and cooldown in ms.
# Defaults 3 / 60000.
GTTS_BREAKER_THRESHOLD=
GTTS_BREAKER_COOLDOWN_MS=
# Legacy gTTS chunks fetched concurrently (1 = serial). Default 3.
GTTS_CHUNK_CONCURRENCY=
# SECRET-04 (plano 032): força o PUT global de comandos mesmo sem mudanças (ignora o
# fingerprint em cache). Default OFF (só regista quando os comandos mudam).
FORCE_REGISTER=
# Rust migration: lets the Rust runtime own idempotent global/owner command registration. It uses
# a separate `commands-state-rust.json` cache by default, so a Rust shadow process never suppresses
# the Node registration state. Keep OFF until Rust is the only gateway process.
RUST_REGISTER_COMMANDS_ENABLED=false
RUST_AUTOCOMPLETE_ENABLED=false
# R4 staging only: when set to a Discord guild snowflake, public Rust commands are registered in
# that guild instead of globally. Use a separate staging application/token; leave empty for
# production. The owner guild is merged into one PUT when it is the same guild, preventing the
# owner-only refresh from erasing the public staging commands.
RUST_COMMANDS_GUILD_ID=
# Optional path for the Rust command-registration fingerprint cache.
RUST_COMMANDS_STATE_PATH=
# Rust owner-only /vozen-grant and /generate-code sink. Requires OWNER_ID and OWNER_GUILD_ID;
# keep OFF until the Rust gateway has been verified against the Node monetization behavior.
RUST_OWNER_COMMANDS_ENABLED=false
# Rust may own /transcribe revoke independently. Live start/stop uses the consent registry from
# the same receiver and is controlled by RUST_TRANSCRIBE_LIVE_ENABLED.
RUST_TRANSCRIBE_CONTROL_ENABLED=false
# Modelo do Whisper para o /transcribe (STT). Default 'base' (calibrado para o VPS —
# ver docs/SPIKE-STT.md). Outros valores: tiny, small, medium... (mais lento/melhor).
WHISPER_MODEL=
# Pool de processos do Piper reutilizados entre sínteses (~4x mais rápido). Default ON
# (qualquer valor != '0'/'false'/'off' mantém ligado). Desliga com PIPER_PERSISTENT=0.
PIPER_PERSISTENT=
# Nº de vozes "quentes" mantidas no pool do Piper. Default 3.
PIPER_WARM_VOICES=
# Cap de processos do Piper a correr em simultâneo (anti-stampede de CPU/RAM). Default
# max(1, núcleos - 1).
PIPER_MAX_CONCURRENCY=
