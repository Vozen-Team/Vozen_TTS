# Production Rust cutover fragment.
# Start from the existing VPS .env and append this file to create .env.rust.prod.
# Never commit the resulting .env.rust.prod; it contains the production token and API secrets.

RUST_RUNTIME_MODE=full
RUST_RUNTIME_READY=true
RUST_REGISTER_COMMANDS_ENABLED=true
RUST_COMMANDS_GUILD_ID=
RUST_AUTOCOMPLETE_ENABLED=true
RUST_CORE_VOICE_ENABLED=true
RUST_QUEUE_ENABLED=true
RUST_PRONUNCIATION_ENABLED=true
RUST_CONFIG_LANGUAGE_ENABLED=true
RUST_CONFIG_TOGGLES_ENABLED=true
RUST_CONFIG_NUMERIC_ENABLED=true
RUST_CONFIG_ROLE_ENABLED=true
RUST_CONFIG_DEFAULT_VOICE_ENABLED=true
RUST_CONFIG_CHANNEL_ENABLED=true
RUST_CONFIG_QUEUE_ROLES_ENABLED=true
RUST_CONFIG_GREET_LANGUAGE_ENABLED=true
RUST_CONFIG_BLOCKWORD_ENABLED=true
RUST_CONFIG_SHOW_ENABLED=true
RUST_CONFIG_RESET_ENABLED=true
RUST_UPTIME_ENABLED=true
RUST_INVITE_ENABLED=true
RUST_HELP_ENABLED=true
RUST_VOTE_ENABLED=true
RUST_TOP_SPEAKERS_ENABLED=true
RUST_BIRTHDAY_ENABLED=true
RUST_BOT_STATS_ENABLED=true
RUST_SERVER_STATS_ENABLED=true
RUST_STATS_ENABLED=true
RUST_PREMIUM_ENABLED=true
RUST_PAYMENTS_ENABLED=false
# Stripe is injected into .env.rust.prod by the production deploy workflow after
# the repository STRIPE_* secrets are configured. Keep this disabled until then.
PREMIUM_API_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_YEARLY=
RUST_REDEEM_ENABLED=true
RUST_PRIVACY_ENABLED=true
RUST_GAME_LIST_ENABLED=true
RUST_GAME_SCORES_ENABLED=true
RUST_GAME_PLAY_ENABLED=true
RUST_PUBLIC_COMMANDS_ENABLED=true
RUST_TTS_FILE_ENABLED=true
RUST_TRANSCRIBE_MESSAGE_ENABLED=true
RUST_TRANSCRIBE_LIVE_ENABLED=true
RUST_TRANSCRIBE_CONTROL_ENABLED=true
RUST_SPEAK_CONTEXT_ENABLED=true
RUST_VOICE_PREFERENCES_ENABLED=true
RUST_TRANSLATE_TEXT_ENABLED=true
RUST_TRANSLATE_CONTEXT_ENABLED=true
RUST_TRANSLATION_ADMIN_ENABLED=true
RUST_TRANSLATION_PREFERENCES_ENABLED=true
RUST_AUTOMATIC_TRANSLATION_ENABLED=true
RUST_WELCOME_ENABLED=true
RUST_MESSAGE_AUTOREAD_ENABLED=true
RUST_RANDOMIZER_ENABLED=true
RUST_CAST_ENABLED=true
RUST_SETUP_ENABLED=true
RUST_OWNER_COMMANDS_ENABLED=true
RUST_BROWSER_API_ENABLED=true
RUST_DASHBOARD_ENABLED=true
RUST_ADMIN_API_ENABLED=true

# Rust serves the existing reverse-proxy/API port after Node is stopped.
HEALTH_PORT=3001
HEALTH_HOST=0.0.0.0
# Public, privacy-safe status JSON consumed by https://bot.example.com/status.
# The production compose file also enforces this value for the VPS runtime.
PUBLIC_STATUS_ENABLED=true
SINGLE_INSTANCE_PORT=59595
WHISPER_MODEL=small
WHISPER_BEAM_SIZE=5
RUST_TTS_FILE_CACHE_DIR=/data/audio-cache/rust-file
RUST_KOKORO_CACHE_DIR=/data/audio-cache/rust-kokoro
